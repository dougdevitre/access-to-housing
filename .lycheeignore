# Exclusions for the Link check workflow (.github/workflows/link-check.yml).
# One regular expression per line. Every entry says why it is skipped.

# tel: and sms: links are phone numbers, not web pages, so there is nothing to fetch.
^tel:
^sms:

# API endpoints (api.census.gov, api.walkscore.com, api.usa.gov, ...) are named as
# endpoints for developers. They answer 4xx without a key or query, which is not
# a dead link.
^https?://api[.-]
^https?://data\.hud\.gov/Housing_Counselor
^https?://airdna\.co/api

# Placeholder pattern from the docs ("311.city.gov" stands for a city's portal).
^https?://311\.city\.gov

# Root-relative Jekyll links such as /access-to-housing/reference-pods/ point at
# pages GitHub Pages builds under the site's baseurl, not at files in the repo,
# so they cannot be checked as local files.
^file://.*/access-to-housing/reference-pods/?$

# housepriceindex.ca (Teranet-National Bank HPI) loads in browsers, but lychee's
# TLS stack does not trust its certificate chain. Checked by hand 2026-10-18.
^https?://(www\.)?housepriceindex\.ca

# TEMPORARY: dougdevitre.github.io/access-to-housing is this project's own site,
# not a data source. The "Deploy to GitHub Pages" workflow has failed on every
# run since April 2026, so the docs site 404s. Remove this line once it serves again.
^https?://dougdevitre\.github\.io/access-to-housing

# BROKEN — needs a human (found 2026-10-23)
^https://walkscore\.com/?$

# FEMA Flood Map Service Center. The site is live (its contact page loaded on
# 2026-10-23), but it resets connections from GitHub's CI runners
# ("Connection reset by peer" on two runs in a row), so the checker can't reach it.
# Remove this line once the link check can reach msc.fema.gov again.
^https?://msc\.fema\.gov
